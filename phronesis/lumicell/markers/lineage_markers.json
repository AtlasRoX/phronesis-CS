      "negative": [],
      "atlas_include": "(?i)(hematopoietic|haematopoietic|\\bHSPCs?\\b|\\bHSCs?\\b|\\bMPPs?\\b|\\bLMPPs?\\b|common (lymphoid|myeloid)|granulocyte-monocyte progenitor|megakaryocyte-erythroid progenitor|\\bGMPs?\\b|\\bCMPs?\\b|\\bMEPs?\\b)",
