{
  "_meta": {
    "name": "Phronesis Lumicell lineage anchor panel",
    "version": "2026.10.1",
    "species": "human (symbols are matched case-insensitively, so orthologous mouse symbols such as Cd3e also match)",
    "purpose": "First (lineage) level of hierarchical marker-based cluster annotation. Each lineage has positive markers (lineage anchors) and negative markers whose expression counts against the lineage. The large atlas in cell_markers.json is only used afterwards to suggest a subtype within the called lineage.",
    "curation": "Canonical, widely used lineage markers; every gene below is a textbook marker of its lineage in human single-cell RNA-seq. Hand-curated, not derived automatically; changes must bump the version.",
    "sources": [
      "Wolf FA, Angerer P, Theis FJ. SCANPY: large-scale single-cell gene expression data analysis. Genome Biol 2018;19:15 (PBMC3k tutorial marker table: IL7R, CD14, LYZ, MS4A1, CD8A, GNLY, NKG7, FCGR3A, MS4A7, FCER1A, CST3, PPBP)",
      "Hao Y et al. Integrated analysis of multimodal single-cell data. Cell 2021;184:3573-3587 (Azimuth human PBMC reference, level-1/level-2 marker genes)",
      "Tabula Sapiens Consortium. The Tabula Sapiens: a multiple-organ, single-cell transcriptomic atlas of humans. Science 2022;376:eabl4896 (compartment markers: epithelial, endothelial, stromal, immune)",
      "Ianevski A, Giri AK, Aittokallio T. Fully-automated and ultra-fast cell-type identification using specific marker combinations from single-cell transcriptomic data. Nat Commun 2022;13:1246 (ScType: z-scored positive/negative marker scoring with marker-specificity weights; method basis)"
    ],
    "blood_tissue_pattern": "(?i)\\b(blood|pbmcs?|peripheral blood|bone marrow|cord blood|leukocytes?|buffy coat|apheresis)\\b"
  },
  "lineages": {
    "cd4_t": {
      "label": "CD4+ T cells",
      "group": "T cells",
      "compartment": "hematopoietic",
      "positive": ["CD3D", "CD3E", "CD3G", "CD4", "IL7R", "CD40LG", "MAL"],
      "negative": ["CD8A", "CD8B", "GNLY"],
      "atlas_include": "(?i)(CD4\\+|\\bTregs?\\b|regulatory T|T regulatory|\\bTh ?\\d|Th17|T helper|helper T|\\bTfh\\b|follicular helper|\\bTph\\b)",
      "atlas_exclude": "(?i)(CD8|double-positive|NKT|killer T|thymocyte)"
    },
    "cd8_t": {
      "label": "CD8+ T cells",
      "group": "T cells",
      "compartment": "hematopoietic",
      "positive": ["CD3D", "CD3E", "CD3G", "CD8A", "CD8B"],
      "negative": ["CD40LG"],
      "atlas_include": "(?i)(CD8\\+|cytotoxic T|T cytotoxic|\\bCTLs?\\b)",
      "atlas_exclude": "(?i)(CD4\\+|double-positive|NKT|killer T|thymocyte)"
    },
    "nk": {
      "label": "NK cells",
      "group": "NK cells",
      "compartment": "hematopoietic",
      "positive": ["NKG7", "GNLY", "KLRD1", "KLRF1", "NCAM1", "PRF1", "GZMB"],
      "negative": ["CD3D", "CD3E", "CD3G"],
      "atlas_include": "(?i)(\\bNK\\b|natural killer)",
      "atlas_exclude": "(?i)(NKT|killer T|\\bT cells?\\b)"
    },
    "b": {
      "label": "B cells",
      "group": "B cells",
      "compartment": "hematopoietic",
      "positive": ["CD79A", "CD79B", "MS4A1", "CD19", "CD22", "BANK1", "PAX5"],
      "negative": ["CD3E"],
      "atlas_include": "(?i)(\\bB[ -]?cells?\\b|\\bB lymphocytes?\\b|\\bABCs\\b)",
      "atlas_exclude": "(?i)(plasma|pre-B|pro-B)"
    },
    "plasma": {
      "label": "Plasma cells",
      "group": "B cells",
      "compartment": "hematopoietic",
      "positive": ["JCHAIN", "MZB1", "SDC1", "XBP1", "PRDM1", "TNFRSF17"],
      "negative": ["MS4A1"],
      "atlas_include": "(?i)(plasma ?cells?|plasmablasts?)",
      "atlas_exclude": "(?i)plasmacytoid"
    },
    "cd14_mono": {
      "label": "CD14+ monocytes",
      "group": "Monocytes",
      "compartment": "hematopoietic",
      "positive": ["CD14", "LYZ", "S100A8", "S100A9", "FCN1", "VCAN"],
      "negative": ["FCGR3A", "CD3E"],
      "atlas_include": "(?i)(\\bmonocytes?\\b)",
      "atlas_exclude": "(?i)(non-classical|nonclassical|FCGR3A|CD16|intermediate|derived|progenitor|MDSC|suppressor)"
    },
    "fcgr3a_mono": {
      "label": "FCGR3A+ (CD16+) monocytes",
      "group": "Monocytes",
      "compartment": "hematopoietic",
      "positive": ["FCGR3A", "MS4A7", "CDKN1C", "LST1", "RHOC", "HES4"],
      "negative": ["CD14", "CD3E"],
      "atlas_include": "(?i)(non-classical monocyte|nonclassical monocyte|FCGR3A\\+ ?(non-classical )?monocyte|CD16\\+ monocyte|monocytes \\(FCGR3A)",
      "atlas_exclude": "(?i)derived"
    },
    "cdc": {
      "label": "Conventional dendritic cells",
      "group": "Dendritic cells",
      "compartment": "hematopoietic",
      "positive": ["FCER1A", "CD1C", "CLEC10A", "CLEC9A", "XCR1"],
      "negative": ["CD14", "CD3E"],
      "atlas_include": "(?i)(dendritic|\\bcDCs?\\d?\\b|\\bmregDC\\b)",
      "atlas_exclude": "(?i)(plasmacytoid|\\bpDC|follicular dendritic|\\bFDC\\b)"
    },
    "pdc": {
      "label": "Plasmacytoid dendritic cells",
