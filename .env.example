# Phronesis environment template, generated by scripts/gen_env_reference.py (see docs/configuration.md).
# Copy to .env and uncomment what you need. Every line shows the default; secrets are left blank.
# Never commit a filled-in .env.

# --- State directories ---
# Directories (os.pathsep-separated) that typed dataset paths may point into; <cwd>/data when unset.
# PHRONESIS_DATASET_ROOTS=
# One data root (`~` expanded): memory/, runs/, uploads/, jobs/, tool_cache/ default under it.
# PHRONESIS_DATA_DIR=
# Background-job SQLite store directory (wins over PHRONESIS_RUNS_DIR/jobs).
# PHRONESIS_JOBS_DIR=
# Clinical memory vault directory (wins over PHRONESIS_DATA_DIR); also the projects store fallback.
# PHRONESIS_MEMORY_DIR=
# Projects store directory (wins over PHRONESIS_MEMORY_DIR and PHRONESIS_DATA_DIR).
# PHRONESIS_PROJECTS_DIR=
# Run-manifest store (wins over PHRONESIS_DATA_DIR; also hosts jobs/ and tool_cache/).
# PHRONESIS_RUNS_DIR=
# Tool-result SQLite cache directory (wins over PHRONESIS_RUNS_DIR/tool_cache).
# PHRONESIS_TOOL_CACHE_DIR=
# Uploaded datasets directory (wins over PHRONESIS_DATA_DIR).
# PHRONESIS_UPLOAD_ROOT=

# --- Retention and maintenance ---
# Finished jobs older than this many days are purged (0 keeps them).
# PHRONESIS_JOB_TTL_DAYS=30.0
# Retention sweep switch: off, auto (off under pytest) or on.
# PHRONESIS_MAINTENANCE=auto
# Hours between retention sweeps.
# PHRONESIS_MAINTENANCE_INTERVAL_H=6.0
# Newest run manifests kept across users (0 = unlimited).
# PHRONESIS_MAX_RUNS=500
# Maximum stored run manifests kept per user (0 = unlimited).
# PHRONESIS_MAX_RUNS_PER_USER=500
# Deployment salt for hashing user identifiers in exported run manifests.
# PHRONESIS_USER_HASH_SALT=

# --- Authentication ---
# Allow non-loopback connections when authentication is disabled (unsafe).
# PHRONESIS_ALLOW_INSECURE=false
# Static bearer tokens as comma-separated `token:user_id` pairs.
# PHRONESIS_API_TOKENS=
# `disabled` runs every request as one local user (development only); otherwise bearer auth is required.
# PHRONESIS_AUTH_MODE=
# Required JWT `aud` claim when set.
# PHRONESIS_JWT_AUDIENCE=
# Required JWT `iss` claim when set.
# PHRONESIS_JWT_ISSUER=
# HS256 secret for bearer JWTs (`sub` = user id, `exp` required).
# PHRONESIS_JWT_SECRET=

# --- API server ---
# Allowed HTTP Host header values (comma-separated; defaults to loopback when auth is disabled).
# PHRONESIS_ALLOWED_HOSTS=
# Comma-separated browser origins allowed by CORS (also allowed by the MCP endpoint).
# PHRONESIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Seconds the upstream readiness probes of /api/health are cached.
# PHRONESIS_HEALTH_CACHE_S=60.0
# Questions one user may have running at once (over it the request is refused).
# PHRONESIS_MAX_CONCURRENT_CHATS_PER_USER=2
# Model-generated thread titles per user at once (over it a heuristic title is used).
# PHRONESIS_MAX_CONCURRENT_TITLES_PER_USER=2
# Load the local PrimeKG graph in the background at startup (0/off/false/no disables).
# PHRONESIS_PRIMEKG_PRELOAD=true
# Seconds between keep-alive comments on chat and job event streams.
# PHRONESIS_SSE_HEARTBEAT_S=15.0
# Fail startup when configuration validation reports a problem instead of only logging it.
# PHRONESIS_STRICT_CONFIG=false
# Fail startup when an optional API router cannot be imported instead of disabling it.
# PHRONESIS_STRICT_ROUTERS=false

# --- PHRONESIS_MCP_*: MCP and A2A endpoints ---
# Seconds a blocking A2A message/send waits for its job before returning the task.
# PHRONESIS_A2A_BLOCKING_TIMEOUT_S=300.0
# Extra comma-separated origins the MCP endpoint accepts besides PHRONESIS_CORS_ORIGINS.
# PHRONESIS_MCP_ALLOWED_ORIGINS=
# Concurrent MCP research calls per user.
# PHRONESIS_MCP_MAX_CONCURRENT=2
# Seconds an MCP research call may run before it is cancelled.
# PHRONESIS_MCP_RESEARCH_TIMEOUT_S=900.0
# Comma-separated registry tools exposed over MCP (default: the built-in allowlist).
# PHRONESIS_MCP_TOOLS=

# --- PHRONESIS_JOB_*: Background jobs ---
# Seconds a cancelled job may take to stop before it is marked cancelled anyway.
# PHRONESIS_JOB_CANCEL_GRACE_S=20.0
# Progress events kept per job; older ones are dropped.
# PHRONESIS_JOB_MAX_EVENTS=20000
# Background-job worker tasks.
# PHRONESIS_JOB_WORKERS=2
# Queued + running background jobs per user.
# PHRONESIS_MAX_JOBS_PER_USER=3

# --- Models and LLM providers ---
# Default model id when a request names none (the orchestrator default when unset; gpt-4o-mini for the Lumicell SCP agent).
# AIAGENTS4PHARMA_LLM_MODEL=  # default: gpt-4o-mini
# Read timeout in seconds between streamed completion chunks.
# LLM_STREAM_TIMEOUT=120.0
# Wall-clock cap in seconds on one streamed completion.
# LLM_STREAM_TOTAL_TIMEOUT=1800.0
# Per-request LLM client timeout in seconds.
# LLM_TIMEOUT=60.0
# NVIDIA NIM models (default LLM provider) and the NIM structure tools.
# NVIDIA_API_KEY=
# Alternative name for NVIDIA_API_KEY (used when that one is unset).
# NVIDIA_NIM_API_KEY=
# OpenAI models; also the fallback when no NVIDIA key is set.
# OPENAI_API_KEY=
# Extra comma-separated model ids callers may select besides the built-in catalog.
# PHRONESIS_ALLOWED_MODELS=
# Allow fallback to an available provider when the requested model key is unset.
# PHRONESIS_LLM_FALLBACK=true
# Model that writes the final answer (default: the turn's model).
# PHRONESIS_SYNTHESIS_MODEL=

# --- PHRONESIS_AGENT_*: Agentic runtime ---
# Seconds a plan waits for the user's approval before running as proposed.
# PHRONESIS_AGENT_APPROVAL_TIMEOUT=300.0
# Seconds one agent model call (plan, critique, verdict) may take.
# PHRONESIS_AGENT_CALL_TIMEOUT=180.0
# Sub-question decomposition: off, auto (complex questions only) or on (always).
# PHRONESIS_AGENT_DECOMPOSE=auto
# Agent model calls kept for the final rewrite and verifier revision (0 when the call budget is below 6).
# PHRONESIS_AGENT_FINAL_RESERVE_CALLS=2
# Run budget tokens kept for the final rewrite and verifier revision; optional agent work stops before them (unset = 12% of the token budget, at least 20k, at most 30%).
# PHRONESIS_AGENT_FINAL_RESERVE_TOKENS=  # default: default_reserve
# Run budget: draft/critique/revise rounds.
# PHRONESIS_AGENT_MAX_DRAFT_ROUNDS=2
# Run budget: agent model calls.
# PHRONESIS_AGENT_MAX_LLM_CALLS=40
# Explicit per-reply output token cap for agent calls (0/unset = budget-derived only).
# PHRONESIS_AGENT_MAX_OUTPUT_TOKENS=0
# Run budget: nodes in one plan.
# PHRONESIS_AGENT_MAX_PLAN_NODES=12
# Run budget: replans after failed or missing evidence.
# PHRONESIS_AGENT_MAX_REPLANS=1
# Run budget: wall-clock seconds (0 = no limit).
# PHRONESIS_AGENT_MAX_SECONDS=0.0
# Run budget: model tokens.
# PHRONESIS_AGENT_MAX_TOKENS=250000
# Run budget: tool calls.
# PHRONESIS_AGENT_MAX_TOOL_CALLS=40
# Model for agentic planning/critique calls (default: the turn's model).
# PHRONESIS_AGENT_MODEL=
# Output tokens admitted per agent model call; also its max_tokens, so concurrent calls cannot overshoot the budget together.
# PHRONESIS_AGENT_OUTPUT_RESERVE_TOKENS=4096
# Plan-and-execute phase: off disables it.
# PHRONESIS_AGENT_PLAN=auto
# Plan nodes executed in parallel.
# PHRONESIS_AGENT_PLAN_CONCURRENCY=4
# Plan execution: dag (one plan, parallel nodes) or react (step-by-step tool rounds).
# PHRONESIS_AGENT_PLAN_MODE=dag
# Maximum tool rounds in react plan mode.
# PHRONESIS_AGENT_REACT_STEPS=4
# Keep model reasoning on for short agent calls (plans, critiques, JSON verdicts).
# PHRONESIS_AGENT_THINKING=false
# Action on approval timeout: withhold_expensive (default) or reject.
# PHRONESIS_APPROVAL_ON_TIMEOUT=withhold_expensive
# Seconds a tool-approval request waits for the user before it is denied.
# PHRONESIS_APPROVAL_TIMEOUT_S=300.0
# Seconds a cancelled or deadline-expired model call is waited for before it is abandoned.
# PHRONESIS_CANCEL_GRACE_S=2.0
# Counter-evidence search for research answers: off disables it.
# PHRONESIS_COUNTER_EVIDENCE=auto
# Orchestration framework used when a request names none or an unknown one (default: auto routing for API requests; the classic pipeline for direct orchestrator calls).
# PHRONESIS_DEFAULT_FRAMEWORK=
# Output tokens (reasoning included) admitted for the first draft of an agentic run and sent as its max_tokens.
# PHRONESIS_FIRST_DRAFT_MAX_OUTPUT_TOKENS=16000
# Seconds between liveness re-emits of a step waiting on a long model call (0 disables).
# PHRONESIS_PROGRESS_HEARTBEAT_S=5.0
# Most output tokens one answer rewrite or verifier revision may produce (never more than the run budget has left; a rewrite that would be cut off is skipped).
# PHRONESIS_REWRITE_MAX_OUTPUT_TOKENS=8192
# Auto routing outcome store (default <PHRONESIS_RUNS_DIR>/router, else <PHRONESIS_DATA_DIR>/router, else data/router).
# PHRONESIS_ROUTER_DIR=
# Auto routing outcome learning: off, auto (off under pytest) or on.
# PHRONESIS_ROUTER_LEARNING=auto
# Auto routing: off scores the deterministic signals only; auto/on add the model's semantic features.
# PHRONESIS_ROUTER_LLM=auto
# Auto routing: semantic feature samples averaged per question (self-consistency).
# PHRONESIS_ROUTER_SAMPLES=1
# Local sentence-transformers model id for embedding-based tool retrieval (unset = lexical only).
# PHRONESIS_TOOL_EMBEDDINGS=

# --- PHRONESIS_NLI_*: Claim verification (NLI) ---
# Claim-vs-evidence NLI: off, auto (cross-encoder, else LLM), model (cross-encoder only) or llm.
# PHRONESIS_NLI=auto
# Cross-encoder batch size.
# PHRONESIS_NLI_BATCH=16
# Words per evidence window scored against a claim.
# PHRONESIS_NLI_CHUNK_WORDS=120
# Contradiction probability at or above which a claim is contradicted.
# PHRONESIS_NLI_CONTRADICT=0.8
# Entailment probability at or above which a claim is supported.
# PHRONESIS_NLI_ENTAIL=0.5
# Claims per LLM NLI call.
# PHRONESIS_NLI_LLM_BATCH=4
# LLM NLI calls per run (hard ceiling 12).
# PHRONESIS_NLI_MAX_LLM_CALLS=12
# Hugging Face cross-encoder used for NLI.
# PHRONESIS_NLI_MODEL=cross-encoder/nli-deberta-v3-base
# Entailment probability below which a claim is unsupported.
# PHRONESIS_NLI_UNSUPPORTED=0.15

# --- PHRONESIS_CONFIDENCE_*: Confidence calibration ---
# JSON file with a fitted temperature, conformal threshold and feature weights.
# PHRONESIS_CONFIDENCE_CALIBRATION=
# Model-elicited confidence for claims: off disables it.
# PHRONESIS_CONFIDENCE_ELICIT=auto
# Confidence temperature override (positive; clamped to 0.05-20).
# PHRONESIS_CONFIDENCE_T=

# --- Query planning and synthesis ---
# Seconds for query normalization when the caller keeps the 3.5 s default.
# PHRONESIS_NORMALIZER_BUDGET_S=
# LLM query planner: off, auto (when heuristics are unsure) or always.
# PHRONESIS_PLANNER=auto
# Skip the entity resolver in query normalization (1/true/yes).
# PHRONESIS_RESOLVER_DISABLED=false
# Seconds the pipeline waits for the LLM search plan before using the heuristic one.
# PHRONESIS_SEARCH_PLAN_WAIT_S=6.0
# Stream raw model reasoning to the client (it is not checked by the verifier).
# PHRONESIS_SHOW_REASONING=false

# --- Tool reliability and cache ---
# Seconds an open circuit breaker waits before a trial call.
# PHRONESIS_BREAKER_COOLDOWN_S=60.0
# Consecutive failures that open an adapter's circuit breaker.
# PHRONESIS_BREAKER_THRESHOLD=5
# Thread pool size for CPU-bound native tools.
# PHRONESIS_NATIVE_WORKERS=4
# Thread pool size for synchronous networked tools.
# PHRONESIS_NETWORK_WORKERS=16
# Tool retry/breaker/cache policies: off, auto (off under pytest) or on.
# PHRONESIS_RELIABILITY=auto
# Tool-result cache (needs PHRONESIS_RELIABILITY): off, auto (off under pytest) or on.
# PHRONESIS_TOOL_CACHE=auto
# Overrides the per-adapter tool-cache TTL (seconds).
# PHRONESIS_TOOL_CACHE_TTL_S=
# Retries of a networked tool after a transient failure.
# PHRONESIS_TOOL_RETRIES=2

# --- Web search ---
# Base URL of a SearXNG instance with the JSON format enabled (used after Tavily).
# PHRONESIS_SEARXNG_URL=
# Tavily web search (first provider when set).
# TAVILY_API_KEY=

# --- Data sources ---
# BioContext MCP server URL.
# BIOCONTEXT_MCP_URL=https://mcp.biocontext.ai/mcp/
# BioContext and direct-adapter request timeout in seconds.
# BIOCONTEXT_TIMEOUT=25.0
# NCBI E-utilities key (raises the rate limit from 3 to 10 requests/s).
# NCBI_API_KEY=
# Contact e-mail sent with NCBI E-utilities requests.
# NCBI_EMAIL=
# openFDA key (raises the daily request quota).
# OPENFDA_API_KEY=
# Contact e-mail for the Crossref polite pool (citation integrity checks).
# PHRONESIS_CROSSREF_MAILTO=
# Directory with DepMap CRISPRGeneEffect.csv (optional source).
# PHRONESIS_DEPMAP_DIR=
# DepMap release label recorded in provenance (default: the directory name).
# PHRONESIS_DEPMAP_RELEASE=
# ChEMBL request timeout in seconds.
# PHRONESIS_DRUGINTEL_TIMEOUT=12.0
# Register the static omics prompt hooks alongside the omics source tools.
# PHRONESIS_OMICS_PROMPT_RULES=false
# openFDA request timeout in seconds.
# PHRONESIS_OPENFDA_TIMEOUT=10.0
# Local PrimeKG store directory (default ~/.cache/phronesis/primekg).
# PHRONESIS_PRIMEKG_DIR=
# Live source-version probes for run manifests: off, auto (off under pytest) or on.
# PHRONESIS_PROVENANCE_PROBES=auto
# Directory with the SynLethDB human SL bulk file (source skipped without it).
# PHRONESIS_SYNLETHDB_DIR=
# SynLethDB release label recorded in provenance (default: the file name).
# PHRONESIS_SYNLETHDB_RELEASE=
# Load unverified local pickles without SHA-256 sidecars in Synapta (unsafe).
# SYNAPTA_TRUST_LOCAL_PICKLES=false

# --- PHRONESIS_UPLOAD_*: Uploads and datasets ---
# Uploaded datasets kept per user.
# PHRONESIS_UPLOAD_MAX_DATASETS=50
# Largest table (CSV/TSV) upload in MB.
# PHRONESIS_UPLOAD_MAX_MB_CSV=100.0
# Largest .h5ad upload in MB.
# PHRONESIS_UPLOAD_MAX_MB_H5AD=500.0
# Largest SBML model upload in MB.
# PHRONESIS_UPLOAD_MAX_MB_SBML=10.0
# Total upload storage per user in MB.
# PHRONESIS_UPLOAD_MAX_TOTAL_MB=2048.0

# --- Simulation and single-cell analysis ---
# Check BioModels revisions over network: off, auto (off under pytest) or on.
# PHRONESIS_BIOMODELS_REVISION_CHECK=auto
# Seconds a cached BioModels SBML download is trusted before checking its revision.
# PHRONESIS_BIOMODELS_REVISION_TTL_S=86400.0
# Model calibration backend: least_squares or copasi.
# PHRONESIS_CALIBRATION_BACKEND=least_squares
# Seconds a simulation waits for COPASI to be free before timing out.
# PHRONESIS_COPASI_LOCK_WAIT=20.0
# Cells kept for single-cell analysis (larger datasets are subsampled).
# PHRONESIS_LUMICELL_MAX_CELLS=50000
# Cells embedded for the UMAP plot.
# PHRONESIS_LUMICELL_UMAP_MAX_CELLS=20000

# --- PHRONESIS_SANDBOX_*: Code sandbox ---
# Enable the code-execution sandbox tool (on/1/true/yes).
# PHRONESIS_SANDBOX=false
# Memory limit of one sandboxed execution in MB.
# PHRONESIS_SANDBOX_MEMORY_MB=2048
# Seconds one sandboxed execution may run.
# PHRONESIS_SANDBOX_TIMEOUT_S=60

# --- PHRONESIS_EVAL_*: Evaluations ---
# Store full normalised prompts in recorded eval cassettes (easier miss diagnosis, larger files).
# PHRONESIS_CASSETTE_PROMPTS=false
# Downloaded benchmark datasets cache (default ~/.cache/phronesis/evals).
# PHRONESIS_EVAL_CACHE=
# Bearer token the eval runner sends to a remote Phronesis API.
# PHRONESIS_EVAL_TOKEN=

# --- Milvus and PrimeKG vector dump ---
# Let the PrimeKG vector dump pip-install missing packages (`true` only).
# AUTO_INSTALL_PACKAGES=true
# Rows per Milvus insert in the PrimeKG vector dump.
# BATCH_SIZE=500
# GPU_CAGRA index graph degree.
# CAGRA_GRAPH_DEGREE=32
# GPU_CAGRA index intermediate graph degree.
# CAGRA_INTERMEDIATE_GRAPH_DEGREE=40
# GPU_CAGRA index search width.
# CAGRA_SEARCH_WIDTH=64
# Parquet chunks loaded at once by the PrimeKG vector dump.
# CHUNK_SIZE=5
# PrimeKG vector dump input directory (default: the bundled data directory).
# DATA_DIR=  # default: default_data_dir
# Force CPU mode in the PrimeKG vector dump even when GPU libraries exist (`true` only).
# FORCE_CPU=false
# HNSW index efConstruction.
# HNSW_EF_CONSTRUCTION=200
# HNSW index M (links per node).
# HNSW_M=16
# Logging level of the LithoScribe PDF tools (uppercase: DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO
# Milvus database the PrimeKG vector dump writes to.
# MILVUS_DATABASE=t2kg_primekg
# Milvus host when no MILVUS_URI is set.
# MILVUS_HOST=  # default: 127.0.0.1 / localhost
# Milvus password for the PrimeKG vector dump (stock credential when unset).
# MILVUS_PASSWORD=
# Milvus port when no MILVUS_URI is set.
# MILVUS_PORT=19530
# Milvus/Zilliz access token.
# MILVUS_TOKEN=
# Milvus URI (Zilliz Cloud, server or Milvus Lite file); unset uses host/port or embedded Milvus Lite.
# MILVUS_URI=
# Milvus user for the PrimeKG vector dump.
# MILVUS_USER=root

# --- Streamlit frontend ---
# Azure OpenAI API version.
# AZURE_OPENAI_API_VERSION=2024-02-01
# Azure OpenAI deployment name.
# AZURE_OPENAI_DEPLOYMENT=
# Azure OpenAI endpoint for `Azure/` models in the Streamlit apps.
# AZURE_OPENAI_ENDPOINT=
# Azure OpenAI model name (default: the selected catalog model).
# AZURE_OPENAI_MODEL_NAME=  # default: dic_llm_models[model_name]
# Azure OpenAI model version.
# AZURE_OPENAI_MODEL_VERSION=
# Custom OpenAI-compatible base URL for `OpenAI/` models in the Streamlit apps.
# OPENAI_BASE_URL=
# User id that labels uploads and memory in the Streamlit apps (default from the app config).
# PHRONESIS_STREAMLIT_USER=  # default: cfg.app.frontend.default_user

# --- Testing ---
# Load the workspace `.env` when the API module is imported; tests/conftest.py sets 0 so a developer `.env` never reaches pytest.
# PHRONESIS_LOAD_DOTENV=true
# Set by pytest; `auto` switches and default stores treat its presence as a test run. Never set it yourself.
# PYTEST_CURRENT_TEST=
